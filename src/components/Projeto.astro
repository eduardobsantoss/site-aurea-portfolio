---
// Cartão de projeto: capa + nome + área. Leva para a página do projeto.
import Capa from './Capa.astro';

interface Props {
  projeto: { slug: string; nome: string; area: string; resumo: string };
  /** Cartão de largura total: capa 16:9 e vídeo tocando sozinho ao entrar na tela. */
  largo?: boolean;
  /** Só muda a forma como o vídeo toca; por padrão segue `largo`. */
  toca?: 'sozinho' | 'hover';
  sizes?: string;
  /** Nível do título (2 quando o cartão vem logo abaixo do h1, 3 dentro de uma seção com h2). */
  nivel?: 2 | 3;
}

const { projeto: p, largo = false, toca = largo ? 'sozinho' : 'hover', sizes, nivel = 3 } = Astro.props;
const Titulo = `h${nivel}` as 'h2' | 'h3';
---

<a class="projeto" href={`/projetos/${p.slug}`}>
  <Capa slug={p.slug} nome={p.nome} largo={largo} toca={toca} sizes={sizes} />
  <div class="projeto-info">
    <Titulo class="projeto-nome">
      {p.nome}
      <span class="projeto-seta" aria-hidden="true">→</span>
    </Titulo>
    <p>
      {p.area} · {p.resumo}
    </p>
  </div>
</a>

<style>
  .projeto {
    display: block;
  }

  .projeto-info {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    margin-top: 1.1rem;
  }

  .projeto-nome {
    font-size: var(--t-h3);
  }

  .projeto-info p {
    opacity: 0.7;
  }

  .projeto-seta {
    display: inline-block;
    margin-left: 0.3em;
    transition: transform 0.4s var(--ease);
  }

  .projeto:hover .projeto-seta {
    transform: translateX(0.25em);
  }
</style>
