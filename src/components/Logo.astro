---
// Wordmark da Aurea. Herda a cor do texto (currentColor).
// Traçado provisório, redesenhado a partir do Behance; substituir quando os originais chegarem.
// No primeiro "a" a barra começa em x=0 e o arco termina por baixo dela, para o canto fechar sem degrau.
// Com a prop `desenha`, cada traço é desenhado da esquerda para a direita quando o logo entra na tela
// (usado no rodapé; o observador fica em Base.astro).
interface Props {
  desenha?: boolean;
  class?: string;
}
const { desenha = false, ...resto } = Astro.props;

// Traços na ordem de leitura. Espessura 10.34 nos arcos e hastes, 11.87 nas barras.
const tracos = [
  { d: 'M18.3 18.3A44.83 44.83 0 1 1 5.46 44.93', w: 10.34 },
  { d: 'M0 50H94.83', w: 11.87 },
  { d: 'M114.29 0V50A44.83 44.83 0 0 0 203.95 50V0', w: 10.34 },
  { d: 'M223.55 0V100', w: 10.34 },
  { d: 'M223.55 50A44.83 44.83 0 0 1 300.07 18.3', w: 10.34 },
  { d: 'M317.65 50H496.97', w: 11.87 },
  { d: 'M394.18 81.7A44.83 44.83 0 1 1 406.99 55.32', w: 10.34 },
  { d: 'M420.44 18.3A44.83 44.83 0 1 1 407.63 44.68', w: 10.34 },
];
---

<svg
  viewBox="0 0 502.14 100"
  fill="none"
  stroke="currentColor"
  role="img"
  aria-label="Aurea"
  data-desenha={desenha ? '' : undefined}
  {...resto}
>
  {tracos.map((t, i) => <path d={t.d} stroke-width={t.w} pathLength="1" style={`--t:${i}`} />)}
</svg>

<style>
  /* Só anima com JS (classe "js") e sem preferência por menos movimento; fora disso o logo aparece inteiro. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) svg[data-desenha] path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      transition: stroke-dashoffset 1.1s var(--ease);
      transition-delay: calc(var(--t) * 110ms);
    }

    :global(.js) svg[data-desenha].visivel path {
      stroke-dashoffset: 0;
    }
  }
</style>
