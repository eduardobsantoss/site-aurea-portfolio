---
import Base from '../layouts/Base.astro';
import Monograma from '../components/Monograma.astro';
import Projeto from '../components/Projeto.astro';
import { acaoContato, servicos, projetos } from '../data/site';

const [destaque, ...outros] = projetos;
const dois = (n: number) => String(n).padStart(2, '0');
---

<Base>
  <section class="hero container">
    <h1 data-revela>
      sua ideia.<br />nosso código.<br />seu <span class="grifo">futuro.</span>
    </h1>
    <div class="hero-lado" data-revela style="--i:1">
      <p class="hero-apoio">
        A Aurea cria sites para negócios de Uberaba que querem ser encontrados, lembrados e escolhidos.
      </p>
      <div class="hero-acoes">
        <a class="botao" href={acaoContato.url} target="_blank" rel="noopener">
          {acaoContato.rotulo}
          <span aria-hidden="true">→</span>
        </a>
        <a class="botao -contorno" href="/projetos">Ver projetos</a>
      </div>
    </div>
  </section>

  <section class="destaque container" aria-labelledby="destaque-titulo">
    <p class="kicker" id="destaque-titulo">Projeto em destaque</p>
    <div data-revela>
      <Projeto projeto={destaque} largo sizes="100vw" nivel={2} />
    </div>
  </section>

  <section class="container">
    <div class="painel grao" data-revela>
      <Monograma class="painel-mono" />
      <p>
        Não criamos qualquer tecnologia. Criamos soluções que transformam o <strong>seu mundo,</strong> do jeito que{' '}
        <span class="grifo">você visualiza.</span>
      </p>
    </div>
  </section>

  <section class="folha escuro mais-projetos">
    <div class="container">
      <div class="cabeca">
        <p class="kicker">Projetos</p>
        <h2 data-revela>Trabalhos <span class="grifo">selecionados.</span></h2>
      </div>
      <ul class="projetos -tres">
        {
          outros.map((p, i) => (
            <li data-revela style={`--i:${i}`}>
              <Projeto projeto={p} sizes="(min-width: 48rem) 33vw, 100vw" />
            </li>
          ))
        }
      </ul>
      <p class="mais-projetos-link">
        <a class="link-seta" href="/projetos">Ver todos os projetos <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <div class="fundo-piche">
    <section class="folha claro">
      <div class="container">
        <div class="cabeca">
          <p class="kicker">O que a gente faz</p>
          <h2 data-revela>Tudo o que seu negócio precisa para existir bem na internet.</h2>
        </div>
        <ol class="lista-servicos">
          {
            servicos.map((s, i) => (
              <li>
                <a href={`/servicos#${s.id}`}>
                  <span class="lista-num">{dois(i + 1)}</span>
                  <span class="lista-titulo">{s.titulo}</span>
                  <span class="lista-seta" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Hero */
  .hero {
    padding-top: clamp(8rem, 18vw, 13rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .hero h1 {
    font-size: var(--t-display);
  }

  .hero-lado {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero-apoio {
    max-width: 34ch;
    font-size: var(--t-h3);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .hero-acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  /* No desktop o apoio e os botões ocupam a coluna da direita, alinhados à base do título */
  @media (min-width: 64rem) {
    .hero {
      display: grid;
      grid-template-columns: 1fr minmax(20rem, 27rem);
      align-items: end;
      column-gap: clamp(2rem, 4vw, 5rem);
    }

    .hero-lado {
      margin-top: 0;
      padding-bottom: 0.6rem;
    }
  }

  /* Projeto em destaque */
  .destaque {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .destaque .kicker {
    margin-bottom: 1.25rem;
  }

  /* Painel da marca */
  .painel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    min-height: clamp(22rem, 48vw, 40rem);
    padding: clamp(1.5rem, 4vw, 3.5rem);
    border-radius: var(--raio);
    color: #fff;
    background:
      var(--brilho-lima-canto),
      radial-gradient(50% 70% at 0% 0%, #1a0070 0%, transparent 70%),
      var(--purpura);
  }

  .painel-mono {
    width: clamp(4.5rem, 9vw, 8rem);
    color: var(--lima);
  }

  .painel p {
    max-width: 22ch;
    font-size: var(--t-h2);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .painel strong {
    font-weight: 600;
  }

  .painel .grifo {
    display: inline;
    line-height: inherit;
    background: none;
    padding: 0;
    color: var(--lima);
    font-weight: 600;
  }

  /* Mais projetos */
  .mais-projetos {
    margin-top: var(--secao);
  }

  .mais-projetos-link {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    font-size: var(--t-h3);
    letter-spacing: -0.015em;
  }

  /* Serviços: lista de linhas grandes que levam à página de serviços */
  .lista-servicos {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1.5px solid var(--piche);
  }

  .lista-servicos a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: clamp(1.1rem, 2.4vw, 2rem) 0;
    border-bottom: 1.5px solid var(--piche);
    transition: padding 0.5s var(--ease);
  }

  .lista-num {
    font-size: var(--t-mini);
    font-weight: 500;
    opacity: 0.72;
  }

  .lista-titulo {
    font-size: var(--t-h2);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .lista-seta {
    font-size: var(--t-h3);
    transition: transform 0.5s var(--ease);
  }

  .lista-servicos a:hover {
    padding-left: 0.75rem;
  }

  .lista-servicos a:hover .lista-seta {
    transform: translateX(-0.5rem);
  }

  @media (min-width: 60rem) {
    .lista-servicos a {
      grid-template-columns: 1fr 3fr auto;
    }
  }
</style>
